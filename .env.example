# API
NODE_ENV=development
API_PORT=3333
WEB_ORIGIN=http://localhost:5173
# Proxy reverso na frente da API (ex.: uniquelocal, 1, true); vazio = nenhum
TRUST_PROXY=
# Cookie de sessão Secure: auto (quando o acesso é HTTPS), true ou false
COOKIE_SECURE=auto
DATABASE_PATH=./data/auditoria.sqlite
SNAPSHOTS_DIR=./data/snapshots

# Coleta
# Contato no user-agent do crawler; vazio = e-mail do primeiro auditor cadastrado
CRAWLER_CONTACT_EMAIL=
CRAWLER_MAX_URLS=200
# Proxy da rede institucional, se a máquina só sai para a internet por ele (ex.: http://proxy.iftm.edu.br:3128)
CRAWLER_PROXY=
COLLECTION_CONCURRENCY=2

# Demonstração: o seed importa as coletas de exemplo de apps/api/demo (false = não importa)
DEMO_DATA=true
