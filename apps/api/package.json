{
  "name": "@auditoria-rf/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "node --conditions=development ../../node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "tsx --conditions=development --env-file-if-exists=../../.env src/cli/db-migrate.ts",
    "db:seed": "tsx --conditions=development --env-file-if-exists=../../.env src/cli/db-seed.ts",
    "create-auditor": "tsx --conditions=development --env-file-if-exists=../../.env src/cli/create-auditor.ts",
    "collect": "tsx --conditions=development --env-file-if-exists=../../.env src/cli/collect.ts",
    "discover": "tsx --conditions=development --env-file-if-exists=../../.env src/cli/discover.ts",
    "dogfood": "tsx --conditions=development --env-file-if-exists=../../.env src/cli/dogfood.ts",
    "demo:export": "tsx --conditions=development --env-file-if-exists=../../.env src/cli/demo-export.ts",
    "evidence:backfill": "tsx --conditions=development --env-file-if-exists=../../.env src/cli/evidence-backfill.ts",
    "backup": "tsx --conditions=development --env-file-if-exists=../../.env src/cli/backup.ts",
    "fingerprint:report": "tsx --conditions=development --env-file-if-exists=../../.env src/cli/fingerprint-report.ts",
    "retest": "tsx --conditions=development --env-file-if-exists=../../.env src/cli/retest.ts"
  },
  "dependencies": {
    "@auditoria-rf/contracts": "0.0.0",
    "@axe-core/playwright": "4.13.0",
    "argon2": "0.45.1",
    "axe-core": "4.13.0",
    "better-sqlite3": "13.0.3",
    "cheerio": "1.2.0",
    "commander": "15.0.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "drizzle-orm": "0.45.3",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "fast-xml-parser": "5.11.1",
    "helmet": "8.3.0",
    "pino": "10.3.1",
    "playwright": "1.63.0",
    "robots-parser": "3.0.1",
    "undici": "7.29.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.2",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.1.3",
    "supertest": "7.2.2",
    "tsx": "4.23.15"
  }
}
